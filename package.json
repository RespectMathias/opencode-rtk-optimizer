{
  "name": "opencode-rtk-optimizer",
  "version": "0.1.1",
  "description": "OpenCode plugin for RTK, reduces LLM token consumption by 60-90% on dev commands",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run test:build && node --test .test/index.test.js",
    "test:rtk": "npm run test:build && node --test .test/rtk.test.js",
    "test:plugin": "npm run build && node --test test/plugin.test.mjs",
    "test:build": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "rtk",
    "token-optimization",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "RespectMathias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RespectMathias/opencode-rtk-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/RespectMathias/opencode-rtk-optimizer/issues"
  },
  "homepage": "https://github.com/RespectMathias/opencode-rtk-optimizer#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode/plugin": "^2.0.22"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": { "optional": true },
    "@opencode/plugin": { "optional": true }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.2",
    "@opencode/plugin": "2.0.22",
    "@types/node": "^26.1.1",
    "typescript": "^5.0.0"
  }
}
